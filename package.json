{
  "name": "dazhi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:push:local": "DATABASE_URL=postgresql://postgres:postgres@localhost:5433/keichi?schema=public DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5433/keichi?schema=public prisma db push",
    "db:seed:local": "DATABASE_URL=postgresql://postgres:postgres@localhost:5433/keichi?schema=public DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5433/keichi?schema=public prisma db seed",
    "db:reset:local": "docker compose down -v && docker compose up -d --wait && npm run db:push:local && npm run db:seed:local",
    "db:studio:local": "DATABASE_URL=postgresql://postgres:postgres@localhost:5433/keichi?schema=public DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5433/keichi?schema=public prisma studio",
    "email:test": "node --env-file=.env --env-file-if-exists=.env.local --import tsx scripts/test-email.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@auth/prisma-adapter": "^2.7.4",
    "@prisma/client": "^6.2.1",
    "@react-email/components": "^1.0.11",
    "@types/bcryptjs": "^3.0.0",
    "@types/jszip": "^3.4.1",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "browser-image-compression": "^2.0.2",
    "docxtemplater": "^3.54.1",
    "framer-motion": "^12.38.0",
    "heic-convert": "^2.1.0",
    "heic2any": "^0.0.4",
    "jszip": "^3.10.1",
    "lucide-react": "^1.14.0",
    "next": "14.2.30",
    "next-auth": "^5.0.0-beta.25",
    "pdf-lib": "^1.17.1",
    "pizzip": "^3.1.7",
    "pusher": "^5.2.0",
    "pusher-js": "^8.4.0",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.17.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "14.2.30",
    "file-saver": "^2.0.5",
    "postcss": "^8",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }

# ──────────────────────────────────────────────────────────────────────────────
# AI 大智若愚 — Environment Variables
# Copy to .env.local for local dev.
# Set all variables in the Zeabur dashboard for production.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database (Zeabur PostgreSQL / Neon) ───────────────────────────────────────
# Both are provided automatically when you link a PostgreSQL service on Zeabur.
# For local dev, set both to the same connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dbname?schema=public"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/dbname?schema=public"

# ── NextAuth v5 ───────────────────────────────────────────────────────────────
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET="your-32-byte-random-secret"
# Must exactly match your deployed domain (no trailing slash)
AUTH_URL="https://YOUR_APP.zeabur.app"

# ── Google OAuth ──────────────────────────────────────────────────────────────
# console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URI: https://YOUR_APP.zeabur.app/api/auth/callback/google
AUTH_GOOGLE_ID="YOUR_CLIENT_ID.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="YOUR_CLIENT_SECRET"

# ── Pusher Channels ───────────────────────────────────────────────────────────
# dashboard.pusher.com → Create App → Channels
# Use cluster ap3 (Singapore) for lowest latency in Hong Kong
PUSHER_APP_ID="your_app_id"
PUSHER_SECRET="your_server_secret"
NEXT_PUBLIC_PUSHER_KEY="your_public_key"
NEXT_PUBLIC_PUSHER_CLUSTER="ap3"

# ── AI provider ───────────────────────────────────────────────────────────────
# The active provider/model is chosen in-app at 系統設定 (admin), stored in the DB.
# Secrets stay here in env for security. Set the key(s) for whichever provider(s)
# you may switch to:
#   anthropic  → ANTHROPIC_API_KEY (console.anthropic.com)
#   openrouter → OPENROUTER_API_KEY (openrouter.ai) — one key, many models
#   local      → self-hosted OpenAI-compatible server (Ollama / LM Studio);
#                usually no key. Optional LOCAL_LLM_API_KEY / LOCAL_LLM_BASE_URL.
ANTHROPIC_API_KEY="sk-ant-api03-..."
OPENROUTER_API_KEY=""
# LOCAL_LLM_BASE_URL="http://localhost:1234/v1"
# LOCAL_LLM_API_KEY=""
# LLM_PROVIDER="anthropic"   # optional default before an admin picks one

# ── Admin bootstrap ───────────────────────────────────────────────────────────
# Comma-separated emails always granted ADMIN on login (Google Workspace SSO).
# test2020@ga.keichi.edu.hk is always included in code.
ADMIN_EMAILS=""

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://YOUR_APP.zeabur.app"

# ── Resend (Transactional Email) — discipline follow-up + threshold alerts ────
# resend.com → API Keys
# Free tier: 3,000 emails/month.
# - Without RESEND_API_KEY, sendEmail() silently no-ops (safe for dev/PR previews).
# - For testing without a verified domain: leave RESEND_FROM unset → onboarding@resend.dev
# - For production: verify your domain in Resend, then set RESEND_FROM to your address.
RESEND_API_KEY="re_..."
RESEND_FROM="AI 大智若愚 <noreply@yourdomain.com>"
